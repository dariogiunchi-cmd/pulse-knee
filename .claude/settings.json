{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash test/verifica.sh:*)",
      "Bash(python3 test/checklist.py:*)",
      "Bash(python3 test/verita.py:*)",
      "Bash(python3 test/cervello.py:*)",
      "Bash(node test/logica.js:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ]
  }
}
